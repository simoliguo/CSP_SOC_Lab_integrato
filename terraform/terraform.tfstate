      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "content": "[waf]\r\nvm-waf-modsecurity ansible_host=158.158.76.215\r\n\r\n[siem]\r\nvm-siem-wazuh ansible_host=68.221.200.123\r\n\r\n[targets]\r\nvm-target-juiceshop ansible_host=10.0.2.4\r\n\r\n[all:vars]\r\nansible_user=azureuser\r\nansible_ssh_private_key_file=../terraform/id_rsa\r\nansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'\r\nansible_python_interpreter=/usr/bin/python3\r\n\r\n[targets:vars]\r\nansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ProxyCommand=\"ssh -W %h:%p -q -i ../terraform/id_rsa -o StrictHostKeyChecking=no azureuser@158.158.76.215\"'\r\n",
